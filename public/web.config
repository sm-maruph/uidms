<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Requires IIS URL Rewrite and ARR with proxying enabled. -->
    <rewrite>
      <rules>
        <clear />
        <!-- Preserve /api and its query string; API errors must stay API responses. -->
        <rule name="UIDMS API to Node" stopProcessing="true">
          <match url="^api(?:/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:4000/{R:0}" appendQueryString="true" />
        </rule>

        <!-- Google sender authorization callback. Setup is protected in Node. -->
        <rule name="UIDMS Google OAuth setup" stopProcessing="true">
          <match url="^auth/google/(start|callback|result)$" />
          <action type="Rewrite" url="http://127.0.0.1:4000/{R:0}" appendQueryString="true" />
        </rule>

        <!-- Only browser navigation to a missing application route uses React. -->
        <rule name="UIDMS React routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{URL}" pattern="^/(api|assets)(/|$)" negate="true" />
            <add input="{URL}" pattern="\.[^/]+$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Preserve backend 400/401/403/404/429 JSON and genuine missing-file errors. -->
    <httpErrors existingResponse="PassThrough" errorMode="DetailedLocalOnly" />

    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
